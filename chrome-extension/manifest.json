{
  "manifest_version": 3,
  "name": "DCPROSENS - Sensitivity Converter & Aim Lab",
  "version": "2.2.0",
  "description": "Free 1:1 mouse sensitivity converter, ADS scope calculator, cm/360, eDPI & pro crosshair codes across 87+ FPS games + GTA VI.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Open DCPROSENS Sensitivity Converter (87+ Games)"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open the DCPROSENS side panel"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
