# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases and archives
*.zip
src/lib/leads.json

# mobile app build artifacts (large binaries, never commit)
*.apk
*.aab
android-app/android/**/build/
android-app/android/.gradle/
android-app/www/

# Android app signing key — compromise lets someone else sign updates
# for the same Play Store listing. Never commit, local or otherwise.
*.jks
*.keystore

# local secrets / MCP config with live tokens
.mcp.json

# Firebase Admin service account key — full admin access to Firestore/Auth.
# See secrets/README.md before touching anything in this folder.
/secrets/

# Local standby folder for superseded builds/scripts — see _archive/README.md
/_archive/
/source-images-archive/
/scratch/
/reports/
/research/
/social-media/
**/__pycache__/
*.pyc

