# Old/renamed slug — closest real match
RewriteRule ^best-gaming-mouse-2026/?$ /blog/best-gaming-mouse-for-fps-2026/ [L,R=301]

# Misc legacy URLs found 404ing (wrong prefix, old naming, or hyphenation)
RewriteRule ^pros/niko-cs2-settings/?$ /pros/niko/ [L,R=301]
RewriteRule ^pros-compare/?$ /pros/compare/ [L,R=301]
RewriteRule ^web-stories/top-5-mice-2026/?$ /web-stories/top-5-gaming-mice-2026/ [L,R=301]
RewriteRule ^converter/?$ / [L,R=301]
RewriteRule ^consultoria/?$ /vip-overhaul/ [L,R=301]

# ── Batch 3: remaining 404s from the GSC coverage export (2026-09-03) ──────
# Every target below was verified to exist in out/ before being added.
RewriteRule ^best-cs2-sensitivity-settings-2026/?$ /blog/best-cs2-sensitivity-settings-2026/ [L,R=301]
RewriteRule ^blog/best-gaming-mouse-2026/?$ /blog/best-gaming-mouse-for-fps-2026/ [L,R=301]
RewriteRule ^pros/zekken-valorant-settings/?$ /pros/zekken/ [L,R=301]
# /pros/<game> was never a route — the game filter is a query param on /pros.
RewriteRule ^pros/(apex|cs2|valorant|fortnite|overwatch)/?$ /pros/ [L,R=301]

# Slugs from the WordPress era of this domain: /posts/<slug> was the old
# permalink structure before the Next.js rebuild moved everything to /blog/.
RewriteRule ^posts/valorant-to-cs2-sensitivity-converter-guide/?$ /blog/valorant-to-cs2-sensitivity/ [L,R=301]
RewriteRule ^posts/perfect-sensitivity-approximation-psa-method/?$ /psa-calculator/ [L,R=301]
RewriteRule ^posts/(.*)$ /blog/ [L,R=301]

# GTA VI articles were removed; the standing GTA VI page is the right target.
RewriteRule ^blog/gta-vi-(world-map-vice-city-leonida|gameplay-first-impressions-vice-city|best-vehicles-cars-bikes-boats)/?$ /gta-vi-sensitivity/ [L,R=301]
RewriteRule ^web-stories/gta-vi-first-look-in-pictures/?$ /web-stories/ [L,R=301]
RewriteRule ^exploring-the-world-of-gaming-tips-and-trends/?$ / [L,R=301]

# ── 410 Gone for the dead WordPress/WooCommerce surface ───────────────────
# This domain previously ran WordPress with WooCommerce. Google is still
# retrying /cart/, /checkout/, /product/*, /category/*, feeds and wp-* paths
# and filing each as a 404 crawl error. A 410 tells it the URL is permanently
# gone, so it stops retrying and drops them — a 404 keeps it coming back.
# These are matched before the clean-URL rules so nothing real is affected.
RewriteRule ^(cart|checkout|my-account)/?$ - [G,L]
RewriteRule ^(product|product-category|category|tag|author)(/.*)?$ - [G,L]
RewriteRule ^wp-(admin|content|includes|login|json)(/.*)?$ - [G,L]
RewriteRule ^wp-.*\.php$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^.*/feed/?$ - [G,L]

# Clean URL to HTML mapping
# e.g., /pricing -> /pricing.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# e.g., /pros/tenz -> /pros/tenz.html
RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.html [L]

# e.g., /sens-finder/valorant -> /sens-finder/valorant.html
RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3.html -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ $1/$2/$3.html [L]

# Custom 404 page
ErrorDocument 404 /404.html
</IfModule>
